# Keep line endings correct across Windows and macOS/Linux.
* text=auto

# Shell scripts must stay LF — a CRLF shebang breaks on macOS/Linux.
*.sh text eol=lf

# PowerShell and Windows batch stay CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Treat generated Word docs as binary (no diffing / EOL munging).
*.docx binary
*.pdf binary
