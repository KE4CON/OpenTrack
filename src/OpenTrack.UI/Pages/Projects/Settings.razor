@page "/projects/{Id:int}/settings"
@attribute [Authorize]
@inject IOpenTrackDataService Data
@inject NavigationManager Nav

<PageTitle>Settings — @(projectName ?? "Project")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Settings@(projectName is null ? "" : $" — {projectName}")</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary btn-sm" href="projects/@Id/custom-fields">Custom fields</a>
        <a class="btn btn-outline-primary btn-sm" href="projects/@Id/automation">Automation</a>
        <a class="btn btn-outline-primary btn-sm" href="projects/@Id/sla">SLA targets</a>
        <a class="btn btn-outline-secondary btn-sm" href="projects/@Id">Back to project</a>
    </div>
</div>

@if (!canManage)
{
    <div class="alert alert-warning">You need the Manager role on this project to change its settings.</div>
}
else
{
    @if (message is not null)
    {
        <div class="alert @(messageIsError ? "alert-danger" : "alert-success")">@message</div>
    }

    <div class="row g-4">
        <div class="col-md-6">
            <h2 class="h5">Categories</h2>
            @if (categories.Count == 0) { <p class="text-muted">No categories yet.</p> }
            else
            {
                <ul>@foreach (var c in categories) { <li>@c.Name</li> }</ul>
            }
            <EditForm Model="catAdd" OnValidSubmit="AddCategory" FormName="addCategory" class="mb-3">
                <div class="input-group">
                    <InputText @bind-Value="catAdd.Name" class="form-control" placeholder="New category name" />
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </EditForm>
            @if (categories.Count > 0)
            {
                <EditForm Model="catDel" OnValidSubmit="DeleteCategory" FormName="delCategory">
                    <div class="input-group">
                        <InputSelect @bind-Value="catDel.Id" class="form-select">
                            <option value="0" disabled>Select category…</option>
                            @foreach (var c in categories) { <option value="@c.Id">@c.Name</option> }
                        </InputSelect>
                        <button type="submit" class="btn btn-outline-danger">Delete</button>
                    </div>
                </EditForm>
            }
        </div>

        <div class="col-md-6">
            <h2 class="h5">Versions</h2>
            @if (versions.Count == 0) { <p class="text-muted">No versions yet.</p> }
            else
            {
                <ul>@foreach (var v in versions) { <li>@v.Name @(v.IsReleased ? "(released)" : "")</li> }</ul>
            }
            <EditForm Model="verAdd" OnValidSubmit="AddVersion" FormName="addVersion" class="mb-3">
                <InputText @bind-Value="verAdd.Name" class="form-control mb-2" placeholder="Version name (e.g. 1.0)" />
                <InputText @bind-Value="verAdd.Description" class="form-control mb-2" placeholder="Description (optional)" />
                <div class="row">
                    <div class="col-7"><InputDate @bind-Value="verAdd.ReleaseDate" class="form-control" /></div>
                    <div class="col-5 form-check pt-2">
                        <InputCheckbox @bind-Value="verAdd.IsReleased" class="form-check-input" id="rel" />
                        <label class="form-check-label" for="rel">Released</label>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm mt-2">Add version</button>
            </EditForm>
            @if (versions.Count > 0)
            {
                <EditForm Model="verDel" OnValidSubmit="DeleteVersion" FormName="delVersion">
                    <div class="input-group">
                        <InputSelect @bind-Value="verDel.Id" class="form-select">
                            <option value="0" disabled>Select version…</option>
                            @foreach (var v in versions) { <option value="@v.Id">@v.Name</option> }
                        </InputSelect>
                        <button type="submit" class="btn btn-outline-danger">Delete</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>

    <hr class="my-4" />
    <div class="row">
        <div class="col-lg-8">
            <h2 class="h5">Integrations — outgoing webhooks</h2>
            <p class="form-text">
                Get pinged in Slack, Discord, or your own service whenever an issue in this project is
                created, changed, or commented on. Paste an incoming-webhook URL and pick its format.
                Only add URLs you trust — a webhook URL usually contains a secret token.
            </p>
            @if (webhooks.Count == 0)
            {
                <p class="text-muted">No webhooks yet.</p>
            }
            else
            {
                <EditForm Model="hookDel" OnValidSubmit="DeleteWebhook" FormName="delHook">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Destination</th><th>Format</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var w in webhooks)
                            {
                                <tr>
                                    <td class="small text-break">@w.Url</td>
                                    <td>@w.Format</td>
                                    <td class="text-end">
                                        <button type="submit" name="DelId" value="@w.Id" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </EditForm>
            }
            <EditForm Model="hookAdd" OnValidSubmit="AddWebhook" FormName="addHook">
                <div class="row g-2 align-items-end">
                    <div class="col-md-7">
                        <label class="form-label">Webhook URL</label>
                        <InputText @bind-Value="hookAdd.Url" class="form-control" placeholder="https://hooks.slack.com/services/…" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Format</label>
                        <InputSelect @bind-Value="hookAdd.Format" class="form-select">
                            @foreach (var f in Enum.GetValues<WebhookFormat>()) { <option value="@f">@f</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Add</button>
                    </div>
                </div>
                <div class="form-text">Slack &amp; Discord send a short text message; “Generic” posts full JSON (event, project, issue, status, time).</div>
            </EditForm>
        </div>
    </div>

    <hr class="my-4" />
    <div class="row">
        <div class="col-lg-8">
            <h2 class="h5">Workflow</h2>
            <p class="form-text">
                Restrict which <em>status changes</em> are allowed. Leave this empty to allow any change
                (the default). Once you add even one rule, only the rules you list are permitted.
            </p>
            @if (workflow.Count == 0)
            {
                <p class="text-muted">Open workflow — any status change is allowed.</p>
            }
            else
            {
                <EditForm Model="flowDel" OnValidSubmit="DeleteFlow" FormName="delFlow">
                    <ul class="mb-2">
                        @foreach (var w in workflow)
                        {
                            <li>
                                @w.FromStatus <span aria-hidden="true">→</span> @w.ToStatus
                                <button type="submit" name="Id" value="@w.Id" class="btn btn-sm btn-link text-danger p-0 ms-1">remove</button>
                            </li>
                        }
                    </ul>
                </EditForm>
            }
            <EditForm Model="flowAdd" OnValidSubmit="AddFlow" FormName="addFlow">
                <div class="input-group" style="max-width: 28rem;">
                    <InputSelect @bind-Value="flowAdd.From" class="form-select">
                        @foreach (var s in Enum.GetValues<IssueStatus>()) { <option value="@s">@s</option> }
                    </InputSelect>
                    <span class="input-group-text">→</span>
                    <InputSelect @bind-Value="flowAdd.To" class="form-select">
                        @foreach (var s in Enum.GetValues<IssueStatus>()) { <option value="@s">@s</option> }
                    </InputSelect>
                    <button type="submit" class="btn btn-primary">Allow</button>
                </div>
            </EditForm>
        </div>
    </div>

    <hr class="my-4" />
    <div class="row">
        <div class="col-lg-8">
            <h2 class="h5">Public trouble-ticket intake</h2>
            <p class="form-text">
                Let anyone submit a problem <em>without an account</em> through a public “Report a problem”
                page — handy for a helpdesk, a club, or field reports. Submissions arrive as normal issues.
                Off by default.
            </p>
            <p class="mb-1">Status: <strong>@(intakeEnabled ? "On" : "Off")</strong></p>
            @if (intakeEnabled)
            {
                <p class="mb-2">
                    Public link: <a href="report/@Id" target="_blank">@publicUrl</a>
                    — share this with people who should be able to submit tickets. They can check status at
                    <a href="report/status" target="_blank">@statusUrl</a>.
                </p>
            }
            <EditForm Model="intakeForm" OnValidSubmit="ToggleIntake" FormName="intake">
                <button type="submit" class="btn @(intakeEnabled ? "btn-outline-danger" : "btn-primary")">
                    @(intakeEnabled ? "Turn off public intake" : "Turn on public intake")
                </button>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private string? projectName;
    private bool canManage;
    private IReadOnlyList<CategoryView> categories = [];
    private IReadOnlyList<ProjectVersionView> versions = [];
    private IReadOnlyList<WebhookView> webhooks = [];
    private string? message;
    private bool messageIsError;

    [SupplyParameterFromForm(FormName = "addCategory")] private NameForm catAdd { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "delCategory")] private IdForm catDel { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "addVersion")] private VersionForm verAdd { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "delVersion")] private IdForm verDel { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "addHook")] private HookForm hookAdd { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "delHook")] private DelHookForm hookDel { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "intake")] private EmptyForm intakeForm { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "addFlow")] private FlowForm flowAdd { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "delFlow")] private IdForm flowDel { get; set; } = default!;

    private IReadOnlyList<WorkflowTransitionView> workflow = [];

    private bool intakeEnabled;
    private string publicUrl = "";
    private string statusUrl = "";

    protected override async Task OnInitializedAsync()
    {
        catAdd ??= new();
        catDel ??= new();
        verAdd ??= new();
        verDel ??= new();
        hookAdd ??= new();
        hookDel ??= new();
        intakeForm ??= new();
        flowAdd ??= new();
        flowDel ??= new();
        await Load();
    }

    private async Task AddFlow()
    {
        try { Report(await Data.AddWorkflowTransitionAsync(Id, flowAdd.From, flowAdd.To)); }
        catch (Exception ex) { Report(ex.Message); }
        flowAdd = new(); await Load();
    }
    private async Task DeleteFlow()
    {
        if (flowDel.Id > 0) { try { await Data.DeleteWorkflowTransitionAsync(Id, flowDel.Id); Report(null); } catch (Exception ex) { Report(ex.Message); } }
        flowDel = new(); await Load();
    }

    private sealed class FlowForm { public IssueStatus From { get; set; } = IssueStatus.New; public IssueStatus To { get; set; } = IssueStatus.Acknowledged; }

    private async Task ToggleIntake()
    {
        try { await Data.SetPublicIntakeEnabledAsync(Id, !intakeEnabled); Report(null); }
        catch (Exception ex) { Report(ex.Message); }
        await Load();
    }

    private sealed class EmptyForm { }

    private async Task Load()
    {
        var project = await Data.GetProjectAsync(Id);
        projectName = project?.Name;
        intakeEnabled = project?.PublicIntakeEnabled ?? false;
        publicUrl = $"{Nav.BaseUri}report/{Id}";
        statusUrl = $"{Nav.BaseUri}report/status";
        // Managers-only signal: member-details returns rows only to a manager.
        canManage = (await Data.GetProjectMemberDetailsAsync(Id)).Count > 0;
        categories = await Data.GetProjectCategoriesAsync(Id);
        versions = await Data.GetProjectVersionsAsync(Id);
        webhooks = canManage ? await Data.GetWebhooksAsync(Id) : [];
        workflow = canManage ? await Data.GetWorkflowAsync(Id) : [];
    }

    private async Task AddWebhook()
    {
        try { Report(await Data.AddWebhookAsync(Id, hookAdd.Url ?? "", hookAdd.Format)); }
        catch (Exception ex) { Report(ex.Message); }
        hookAdd = new(); await Load();
    }
    private async Task DeleteWebhook()
    {
        if (hookDel.DelId > 0) { try { await Data.DeleteWebhookAsync(Id, hookDel.DelId); Report(null); } catch (Exception ex) { Report(ex.Message); } }
        hookDel = new(); await Load();
    }

    private async Task AddCategory() { Report(await Data.CreateCategoryAsync(Id, catAdd.Name)); catAdd = new(); await Load(); }
    private async Task DeleteCategory()
    {
        if (catDel.Id > 0) { try { await Data.DeleteCategoryAsync(Id, catDel.Id); Report(null); } catch (Exception ex) { Report(ex.Message); } }
        catDel = new(); await Load();
    }
    private async Task AddVersion()
    {
        Report(await Data.CreateVersionAsync(Id, new CreateVersionInput(verAdd.Name, verAdd.Description, verAdd.ReleaseDate, verAdd.IsReleased)));
        verAdd = new(); await Load();
    }
    private async Task DeleteVersion()
    {
        if (verDel.Id > 0) { try { await Data.DeleteVersionAsync(Id, verDel.Id); Report(null); } catch (Exception ex) { Report(ex.Message); } }
        verDel = new(); await Load();
    }

    private void Report(string? error) { messageIsError = error is not null; message = error ?? "Saved."; }

    private sealed class NameForm { public string Name { get; set; } = ""; }
    private sealed class IdForm { public int Id { get; set; } }
    private sealed class VersionForm
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public DateTime? ReleaseDate { get; set; }
        public bool IsReleased { get; set; }
    }
    private sealed class HookForm { public string? Url { get; set; } public WebhookFormat Format { get; set; } = WebhookFormat.Slack; }
    private sealed class DelHookForm { public int DelId { get; set; } }
}
