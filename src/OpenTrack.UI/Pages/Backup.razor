@page "/backup"
@attribute [Authorize]
@inject IOpenTrackDataService Data
@inject IAttachmentTransfer Transfer

<PageTitle>Backup &amp; export</PageTitle>

<h1 class="h3 mb-3">Backup &amp; export</h1>

<p class="text-muted">
    Export your issues to take them elsewhere, share a report, or keep a safe copy. Exports only ever
    include what you're allowed to see. Coming from MantisBT? You can import your old data below.
</p>

@if (Imp is not null)
{
    <div class="alert @(Imp == "ok" ? "alert-success" : "alert-danger")">
        @switch (Imp)
        {
            case "ok":
                <text>Import complete — @Ic issue(s) across @(Pc + Pm) project(s) (@Pc new, @Pm existing), @Nc note(s), @Tc tag link(s)@(Sk > 0 ? $", {Sk} already-imported skipped" : "").</text>
                break;
            case "forbidden": <text>You need the Manager role to import.</text> break;
            case "badfile": <text>That file didn't look like a MantisBT XML export. Use MantisBT's "Export Issues" to produce the XML, then upload it here.</text> break;
            case "empty": <text>No file was selected.</text> break;
            case "toobig": <text>That file is too large (25 MB limit).</text> break;
            default: <text>Import could not be completed.</text> break;
        }
    </div>
}

@if (Transfer.Host == ClientHostKind.Web)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Spreadsheet (CSV)</h2>
            <p class="form-text">A flat list of issues — opens in Excel, Numbers, or Google Sheets.</p>
            <a class="btn btn-outline-primary" href="export/issues.csv">All issues (CSV)</a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Full backup (JSON), per project</h2>
            <p class="form-text">Everything in a project — issues with their notes, tags, custom-field values, and bug-hunt checklist — in one file you can archive.</p>
            @if (projects.Count == 0)
            {
                <p class="text-muted mb-0">No projects yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Project</th><th class="text-end">Export</th></tr></thead>
                        <tbody>
                            @foreach (var p in projects)
                            {
                                <tr>
                                    <td>@p.Name</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" href="export/issues.csv?projectId=@p.Id">CSV</a>
                                        <a class="btn btn-sm btn-outline-primary" href="export/project/@(p.Id).json">JSON</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        One-click CSV/JSON downloads are available in the <strong>web version</strong> of OpenTrack
        (open it in a browser). In the desktop app you can still back up by copying the database file, below.
    </div>
}

@if (Transfer.Host == ClientHostKind.Web)
{
    <AuthorizeView Policy="RequireManager">
        <Authorized>
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5">Import from MantisBT</h2>
                    <p class="form-text">
                        Moving from MantisBT? In MantisBT, use <em>Export Issues</em> (the XML export) to
                        download a <code>.xml</code> file, then upload it here. Projects, issues, notes,
                        and tags come across; statuses, severities, and priorities map exactly. MantisBT
                        users are matched to your OpenTrack accounts by username where possible, otherwise
                        the original name is kept in the text. Imported projects start private. Run it once
                        per export — re-uploading the same file adds the issues again.
                    </p>
                    <form method="post" action="/import/mantis" enctype="multipart/form-data">
                        <AntiforgeryToken />
                        <div class="input-group" style="max-width: 32rem;">
                            <input type="file" name="file" accept=".xml,text/xml,application/xml" class="form-control" required />
                            <button type="submit" class="btn btn-primary">Import</button>
                        </div>
                    </form>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5">Backing up the whole database</h2>
        <p class="mb-1">Everything OpenTrack stores lives in a single SQLite database file on the computer that runs the server. The simplest complete backup is to copy that file somewhere safe (an external drive, a cloud folder).</p>
        <ul class="mb-0">
            <li>Stop the server first (or copy when it's idle) so the copy is consistent.</li>
            <li>The file is named <code>opentrack.db</code> by default, in the server's data folder; back up the matching <code>-wal</code> and <code>-shm</code> files too if they're present.</li>
            <li>To restore, put the file back in the same place and start the server.</li>
        </ul>
    </div>
</div>

@code {
    private IReadOnlyList<ProjectRow> projects = [];

    // Import result, passed back by the /import/mantis endpoint via redirect.
    [SupplyParameterFromQuery] public string? Imp { get; set; }
    [SupplyParameterFromQuery] public int Pc { get; set; }
    [SupplyParameterFromQuery] public int Pm { get; set; }
    [SupplyParameterFromQuery] public int Ic { get; set; }
    [SupplyParameterFromQuery] public int Sk { get; set; }
    [SupplyParameterFromQuery] public int Nc { get; set; }
    [SupplyParameterFromQuery] public int Tc { get; set; }

    protected override async Task OnInitializedAsync() => projects = await Data.GetProjectsAsync();
}
