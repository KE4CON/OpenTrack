@page "/issues/{Id:int}"
@attribute [Authorize]
@inject IOpenTrackDataService Data

<PageTitle>@(issue?.Title ?? "Issue")</PageTitle>

@if (issue is null)
{
    <p><em>Loading&hellip;</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <p class="text-muted mb-0">@issue.ProjectName / Issue #@issue.Id</p>
            <h1>@issue.Title</h1>
        </div>
        <AuthorizeView Policy="RequireUpdater">
            <Authorized>
                <a class="btn btn-outline-secondary" href="issues/@Id/edit">Edit</a>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="row mb-3">
        <div class="col-md-3"><strong>Status:</strong> @issue.Status</div>
        <div class="col-md-3"><strong>Severity:</strong> @issue.Severity</div>
        <div class="col-md-3"><strong>Priority:</strong> @issue.Priority</div>
        <div class="col-md-3"><strong>Reproducibility:</strong> @issue.Reproducibility</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3"><strong>Reporter:</strong> @issue.ReporterName</div>
        <div class="col-md-3"><strong>Assignee:</strong> @(issue.AssigneeName ?? "Unassigned")</div>
        <div class="col-md-3"><strong>Category:</strong> @(issue.CategoryName ?? "—")</div>
        <div class="col-md-3"><strong>Updated:</strong> @issue.UpdatedAt.ToString("g")</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3"><strong>Resolution:</strong> @issue.Resolution</div>
        <div class="col-md-3"><strong>Due:</strong> @(issue.DueDate is { } d ? d.ToString("d") : "—")</div>
        <div class="col-md-3"><strong>Affects:</strong> @(issue.AffectsVersionName ?? "—")</div>
        <div class="col-md-3"><strong>Fixed in:</strong> @(issue.FixVersionName ?? "—")</div>
    </div>
    @if (issue.IsPrivate)
    {
        <p><span class="badge text-bg-warning">Private issue</span></p>
    }

    <h2 class="h5">Description</h2>
    <p style="white-space: pre-wrap">@issue.Description</p>

    @if (!string.IsNullOrWhiteSpace(issue.StepsToReproduce))
    {
        <h2 class="h5">Steps to Reproduce</h2>
        <p style="white-space: pre-wrap">@issue.StepsToReproduce</p>
    }

    @if (!string.IsNullOrWhiteSpace(issue.ExpectedBehavior))
    {
        <h2 class="h5">Expected Behavior</h2>
        <p style="white-space: pre-wrap">@issue.ExpectedBehavior</p>
    }

    @if (!string.IsNullOrWhiteSpace(issue.ActualBehavior))
    {
        <h2 class="h5">Actual Behavior</h2>
        <p style="white-space: pre-wrap">@issue.ActualBehavior</p>
    }

    <h2 class="h5 mt-4">Notes</h2>
    @if (issue.Notes.Count == 0)
    {
        <p class="text-muted">No notes yet.</p>
    }
    else
    {
        @foreach (var note in issue.Notes)
        {
            <div class="border rounded p-2 mb-2 @(note.IsPrivate ? "border-warning" : "")">
                <div class="small text-muted">
                    @note.AuthorName &mdash; @note.CreatedAt.ToString("g")
                    @if (note.IsPrivate) { <span class="badge text-bg-warning ms-1">Private</span> }
                </div>
                <div style="white-space: pre-wrap">@note.Text</div>
            </div>
        }
    }

    <EditForm Model="noteModel" OnValidSubmit="AddNote" FormName="addNote" class="col-md-8 mt-3">
        <InputTextArea @bind-Value="noteModel.Text" class="form-control mb-2" rows="2" placeholder="Add a note&hellip;" />
        <div class="form-check mb-2">
            <InputCheckbox @bind-Value="noteModel.IsPrivate" class="form-check-input" id="notePrivate" />
            <label class="form-check-label" for="notePrivate">Private note (visible to developers and up)</label>
        </div>
        <button type="submit" class="btn btn-secondary btn-sm">Add Note</button>
    </EditForm>

    <h2 class="h5 mt-4">History</h2>
    @if (history.Count == 0)
    {
        <p class="text-muted">No changes recorded yet.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead><tr><th>When</th><th>Who</th><th>Field</th><th>From</th><th>To</th></tr></thead>
            <tbody>
                @foreach (var h in history)
                {
                    <tr>
                        <td>@h.ChangedAt.ToString("g")</td>
                        <td>@h.UserName</td>
                        <td>@h.FieldChanged</td>
                        <td>@(h.OldValue ?? "—")</td>
                        <td>@(h.NewValue ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private IssueDetail? issue;
    private IReadOnlyList<IssueHistoryEntry> history = [];
    [SupplyParameterFromForm]
    private NoteFormModel noteModel { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        noteModel ??= new();
        await LoadIssue();
    }

    private async Task LoadIssue()
    {
        issue = await Data.GetIssueAsync(Id);
        history = issue is null ? [] : await Data.GetIssueHistoryAsync(Id);
    }

    private async Task AddNote()
    {
        if (string.IsNullOrWhiteSpace(noteModel.Text)) return;
        await Data.AddIssueNoteAsync(Id, noteModel.Text, noteModel.IsPrivate);
        noteModel = new();
        await LoadIssue();
    }

    private sealed class NoteFormModel
    {
        public string Text { get; set; } = string.Empty;
        public bool IsPrivate { get; set; }
    }
}
