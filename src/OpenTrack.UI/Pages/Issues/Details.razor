@page "/issues/{Id:int}"
@attribute [Authorize]
@inject IOpenTrackDataService Data
@inject IAttachmentTransfer Transfer

<PageTitle>@(issue?.Title ?? "Issue")</PageTitle>

@if (issue is null)
{
    <p><em>Loading&hellip;</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <p class="text-muted mb-0">@issue.ProjectName / Issue #@issue.Id</p>
            <h1>@issue.Title</h1>
        </div>
        <div class="d-flex gap-2">
            <EditForm Model="monitorModel" OnValidSubmit="ToggleMonitor" FormName="monitor">
                <button type="submit" class="btn @(isMonitoring ? "btn-secondary" : "btn-outline-secondary")">
                    @(isMonitoring ? "Monitoring ✓" : "Monitor")
                </button>
            </EditForm>
            <AuthorizeView Policy="RequireUpdater">
                <Authorized>
                    <a class="btn btn-outline-secondary" href="issues/@Id/edit">Edit</a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
    <p class="text-muted small mb-2">Monitoring an issue notifies you of changes to it.</p>

    <div class="row mb-3">
        <div class="col-md-3"><strong>Status:</strong> @issue.Status</div>
        <div class="col-md-3"><strong>Severity:</strong> @issue.Severity</div>
        <div class="col-md-3"><strong>Priority:</strong> @issue.Priority</div>
        <div class="col-md-3"><strong>Reproducibility:</strong> @issue.Reproducibility</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3"><strong>Reporter:</strong> @issue.ReporterName</div>
        <div class="col-md-3"><strong>Assignee:</strong> @(issue.AssigneeName ?? "Unassigned")</div>
        <div class="col-md-3"><strong>Category:</strong> @(issue.CategoryName ?? "—")</div>
        <div class="col-md-3"><strong>Updated:</strong> @issue.UpdatedAt.ToString("g")</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3"><strong>Resolution:</strong> @issue.Resolution</div>
        <div class="col-md-3"><strong>Due:</strong> @(issue.DueDate is { } d ? d.ToString("d") : "—")</div>
        <div class="col-md-3"><strong>Affects:</strong> @(issue.AffectsVersionName ?? "—")</div>
        <div class="col-md-3"><strong>Fixed in:</strong> @(issue.FixVersionName ?? "—")</div>
    </div>
    @if (issue.IsPrivate)
    {
        <p><span class="badge text-bg-warning">Private issue</span></p>
    }

    <div class="mb-3">
        <strong>Tags:</strong>
        @if (tags.Count == 0)
        {
            <span class="text-muted">none</span>
        }
        else
        {
            @foreach (var t in tags)
            {
                <span class="badge text-bg-secondary me-1">@t.Name</span>
            }
        }
        <AuthorizeView Policy="RequireUpdater" Context="auth">
            <Authorized>
                @if (tagMessage is not null)
                {
                    <span class="text-danger small ms-2">@tagMessage</span>
                }
                <div class="row g-2 mt-1">
                    <div class="col-md-4">
                        <EditForm Model="addTag" OnValidSubmit="AddTag" FormName="addTag">
                            <div class="input-group input-group-sm">
                                <InputText @bind-Value="addTag.Name" class="form-control" placeholder="add a tag" list="tagOptions" />
                                <button type="submit" class="btn btn-outline-secondary">Add</button>
                            </div>
                        </EditForm>
                        <datalist id="tagOptions">
                            @foreach (var t in allTags) { <option value="@t.Name" /> }
                        </datalist>
                    </div>
                    @if (tags.Count > 0)
                    {
                        <div class="col-md-4">
                            <EditForm Model="removeTag" OnValidSubmit="RemoveTag" FormName="removeTag">
                                <div class="input-group input-group-sm">
                                    <InputSelect @bind-Value="removeTag.Id" class="form-select">
                                        <option value="0" disabled>Remove a tag…</option>
                                        @foreach (var t in tags) { <option value="@t.Id">@t.Name</option> }
                                    </InputSelect>
                                    <button type="submit" class="btn btn-outline-danger">Remove</button>
                                </div>
                            </EditForm>
                        </div>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (customFields.Count > 0)
    {
        <div class="mb-3">
            <strong>Custom fields:</strong>
            <AuthorizeView Policy="RequireUpdater" Context="cfauth">
                <Authorized>
                    @if (cfMessage is not null)
                    {
                        <span class="@(cfIsError ? "text-danger" : "text-success") small ms-2">@cfMessage</span>
                    }
                    @* Values bind via @bind-Value into the pre-populated cf.Entries list so the form works
                       on BOTH the static-SSR web host (form POST) and the interactive desktop host (live
                       binding). The hidden DefinitionId round-trips the key on the SSR post. *@
                    <EditForm Model="cf" OnValidSubmit="SaveCustomFields" FormName="customFields" class="mt-1">
                        <div class="row g-2">
                            @for (var i = 0; i < customFields.Count && i < cf.Entries.Count; i++)
                            {
                                var idx = i;
                                var f = customFields[idx];
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">@f.Name @(f.Required ? "*" : "")</label>
                                    <input type="hidden" name="Entries[@idx].DefinitionId" value="@cf.Entries[idx].DefinitionId" />
                                    @switch (f.Type)
                                    {
                                        case CustomFieldType.Enum:
                                            <InputSelect @bind-Value="cf.Entries[idx].Value" class="form-select form-select-sm">
                                                <option value="">— none —</option>
                                                @foreach (var opt in CustomFieldValidation.ParseEnumOptions(f.EnumOptions))
                                                {
                                                    <option value="@opt">@opt</option>
                                                }
                                            </InputSelect>
                                            break;
                                        case CustomFieldType.Date:
                                            <InputText type="date" @bind-Value="cf.Entries[idx].Value" class="form-control form-control-sm" />
                                            break;
                                        case CustomFieldType.Number:
                                            <InputText type="number" step="any" @bind-Value="cf.Entries[idx].Value" class="form-control form-control-sm" />
                                            break;
                                        default:
                                            <InputText @bind-Value="cf.Entries[idx].Value" class="form-control form-control-sm" />
                                            break;
                                    }
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-sm btn-outline-secondary mt-2">Save custom fields</button>
                        <span class="form-text ms-2">* required. Leave a field blank to clear it (unless required).</span>
                    </EditForm>
                </Authorized>
                <NotAuthorized>
                    <ul class="mb-0">
                        @foreach (var f in customFields)
                        {
                            <li>@f.Name: @(string.IsNullOrEmpty(f.Value) ? "—" : f.Value)</li>
                        }
                    </ul>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    }

    @if (similarIssues.Count > 0)
    {
        <div class="alert alert-light border">
            <strong class="small text-uppercase text-muted">Possibly related</strong>
            <ul class="mb-0 mt-1">
                @foreach (var s in similarIssues)
                {
                    <li><a href="issues/@s.Id">#@s.Id @s.Title</a> <span class="text-muted small">(@s.Status)</span></li>
                }
            </ul>
        </div>
    }

    <h2 class="h5">Description</h2>
    <div class="ot-markdown">@((MarkupString)SafeMarkdown.ToHtml(issue.Description))</div>

    @if (!string.IsNullOrWhiteSpace(issue.StepsToReproduce))
    {
        <h2 class="h5">Steps to Reproduce</h2>
        <div class="ot-markdown">@((MarkupString)SafeMarkdown.ToHtml(issue.StepsToReproduce))</div>
    }

    @if (!string.IsNullOrWhiteSpace(issue.ExpectedBehavior))
    {
        <h2 class="h5">Expected Behavior</h2>
        <div class="ot-markdown">@((MarkupString)SafeMarkdown.ToHtml(issue.ExpectedBehavior))</div>
    }

    @if (!string.IsNullOrWhiteSpace(issue.ActualBehavior))
    {
        <h2 class="h5">Actual Behavior</h2>
        <div class="ot-markdown">@((MarkupString)SafeMarkdown.ToHtml(issue.ActualBehavior))</div>
    }

    <h2 class="h5 mt-4">Attachments</h2>
    @if (attachments.Count == 0)
    {
        <p class="text-muted">No attachments.</p>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (var a in attachments)
            {
                <li class="mb-1 d-flex align-items-center gap-2">
                    @if (Transfer.Host == ClientHostKind.Web)
                    {
                        <a href="@Transfer.DownloadUrl(a.Id)">@a.FileName</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-link p-0" @onclick="() => Download(a)">@a.FileName</button>
                    }
                    <span class="text-muted small">@FormatSize(a.FileSize) &middot; @a.UploadedByName</span>
                    @if (Transfer.Host == ClientHostKind.Web)
                    {
                        <form method="post" action="/attachments/@a.Id/delete" class="d-inline">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm btn-outline-danger py-0">Delete</button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger py-0" @onclick="() => DeleteAttachment(a.Id)">Delete</button>
                    }
                </li>
            }
        </ul>
    }

    @if (Transfer.Host == ClientHostKind.Web)
    {
        <form method="post" action="/attachments/@issue.Id/upload" enctype="multipart/form-data" class="col-md-6 mb-2">
            <AntiforgeryToken />
            <div class="input-group">
                <input type="file" name="file" class="form-control" required />
                <button type="submit" class="btn btn-secondary">Upload</button>
            </div>
        </form>
    }
    else
    {
        <div class="col-md-6 mb-2">
            <InputFile OnChange="OnFileSelected" class="form-control" />
            @if (uploadError is not null)
            {
                <div class="text-danger small mt-1">@uploadError</div>
            }
        </div>
    }

    <h2 class="h5 mt-4">Notes</h2>
    @if (issue.Notes.Count == 0)
    {
        <p class="text-muted">No notes yet.</p>
    }
    else
    {
        @foreach (var note in issue.Notes)
        {
            <div class="border rounded p-2 mb-2 @(note.IsPrivate ? "border-warning" : "")">
                <div class="small text-muted">
                    @note.AuthorName &mdash; @note.CreatedAt.ToString("g")
                    @if (note.IsPrivate) { <span class="badge text-bg-warning ms-1">Private</span> }
                </div>
                <div class="ot-markdown">@((MarkupString)SafeMarkdown.ToHtml(note.Text))</div>
            </div>
        }
    }

    <EditForm Model="noteModel" OnValidSubmit="AddNote" FormName="addNote" class="col-md-8 mt-3">
        <InputTextArea @bind-Value="noteModel.Text" class="form-control mb-2" rows="2" placeholder="Add a note&hellip;" />
        <div class="form-check mb-2">
            <InputCheckbox @bind-Value="noteModel.IsPrivate" class="form-check-input" id="notePrivate" />
            <label class="form-check-label" for="notePrivate">Private note (visible to developers and up)</label>
        </div>
        <button type="submit" class="btn btn-secondary btn-sm">Add Note</button>
    </EditForm>

    <h2 class="h5 mt-4">Relationships</h2>
    @if (relationships.Count == 0)
    {
        <p class="text-muted">No related issues.</p>
    }
    else
    {
        <ul>
            @foreach (var r in relationships)
            {
                <li>
                    @r.Label <a href="issues/@r.OtherIssueId">#@r.OtherIssueId</a> — @r.OtherIssueTitle
                    <span class="text-muted small">(@r.OtherProjectName)</span>
                </li>
            }
        </ul>
    }

    <AuthorizeView Policy="RequireUpdater" Context="auth">
        <Authorized>
            @if (relMessage is not null)
            {
                <div class="alert @(relIsError ? "alert-danger" : "alert-success") py-1">@relMessage</div>
            }
            <div class="row g-2">
                <div class="col-md-7">
                    <EditForm Model="relModel" OnValidSubmit="AddRelationship" FormName="addRelationship">
                        <div class="input-group">
                            <InputSelect @bind-Value="relModel.Type" class="form-select" style="max-width: 10rem">
                                <option value="@IssueRelationshipType.RelatedTo">related to</option>
                                <option value="@IssueRelationshipType.DuplicateOf">duplicate of</option>
                                <option value="@IssueRelationshipType.ParentOf">parent of</option>
                                <option value="@IssueRelationshipType.Blocks">blocks</option>
                            </InputSelect>
                            <span class="input-group-text">issue #</span>
                            <InputNumber @bind-Value="relModel.TargetId" class="form-control" />
                            <button type="submit" class="btn btn-secondary">Add</button>
                        </div>
                    </EditForm>
                </div>
                @if (relationships.Count > 0)
                {
                    <div class="col-md-5">
                        <EditForm Model="removeRelModel" OnValidSubmit="RemoveRelationship" FormName="removeRelationship">
                            <div class="input-group">
                                <InputSelect @bind-Value="removeRelModel.Id" class="form-select">
                                    <option value="0" disabled>Remove a link…</option>
                                    @foreach (var r in relationships)
                                    {
                                        <option value="@r.Id">@r.Label #@r.OtherIssueId</option>
                                    }
                                </InputSelect>
                                <button type="submit" class="btn btn-outline-danger">Remove</button>
                            </div>
                        </EditForm>
                    </div>
                }
            </div>
        </Authorized>
    </AuthorizeView>

    <h2 class="h5 mt-4">History</h2>
    @if (history.Count == 0)
    {
        <p class="text-muted">No changes recorded yet.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead><tr><th>When</th><th>Who</th><th>Field</th><th>From</th><th>To</th></tr></thead>
            <tbody>
                @foreach (var h in history)
                {
                    <tr>
                        <td>@h.ChangedAt.ToString("g")</td>
                        <td>@h.UserName</td>
                        <td>@h.FieldChanged</td>
                        <td>@(h.OldValue ?? "—")</td>
                        <td>@(h.NewValue ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private IssueDetail? issue;
    private IReadOnlyList<IssueHistoryEntry> history = [];
    private IReadOnlyList<IssueRelationshipView> relationships = [];
    private string? relMessage;
    private bool relIsError;
    private IReadOnlyList<AttachmentView> attachments = [];
    private string? uploadError;
    [SupplyParameterFromForm(FormName = "addNote")]
    private NoteFormModel noteModel { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "addRelationship")]
    private AddRelationshipModel relModel { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "removeRelationship")]
    private RemoveRelationshipModel removeRelModel { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "addTag")]
    private AddTagModel addTag { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "removeTag")]
    private RemoveTagModel removeTag { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "monitor")]
    private MonitorModel monitorModel { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "customFields")]
    private CustomFieldsForm cf { get; set; } = default!;

    private bool isMonitoring;
    private IReadOnlyList<TagView> tags = [];
    private IReadOnlyList<TagView> allTags = [];
    private string? tagMessage;
    private IReadOnlyList<CustomFieldValueView> customFields = [];
    private string? cfMessage;
    private bool cfIsError;
    private IReadOnlyList<SimilarIssueView> similarIssues = [];

    protected override async Task OnParametersSetAsync()
    {
        noteModel ??= new();
        relModel ??= new();
        removeRelModel ??= new();
        addTag ??= new();
        removeTag ??= new();
        monitorModel ??= new();
        cf ??= new();
        await LoadIssue();
        // On first render (GET) cf.Entries is empty → seed it from the stored values so the inputs have
        // something to bind to. On an SSR post-back cf.Entries is already populated from the form, so we
        // leave it alone (guard on Count) and never clobber the user's input.
        if (cf.Entries.Count == 0)
            SeedCustomFieldEntries();
    }

    private void SeedCustomFieldEntries() =>
        cf.Entries = customFields.Select(f => new CustomFieldEntry { DefinitionId = f.DefinitionId, Value = f.Value }).ToList();

    private async Task SaveCustomFields()
    {
        cfMessage = null;
        var errors = new List<string>();
        foreach (var e in cf.Entries)
        {
            try
            {
                var error = await Data.SetIssueCustomFieldAsync(Id, e.DefinitionId, e.Value);
                if (error is not null) errors.Add(error);
            }
            catch (UnauthorizedAccessException ex) { errors.Add(ex.Message); }
        }
        cfIsError = errors.Count > 0;
        cfMessage = errors.Count == 0 ? "Saved." : string.Join(" ", errors);
        await LoadIssue();
        cf = new();
        SeedCustomFieldEntries(); // reflect the stored (normalized) values back into the form
    }

    private sealed class CustomFieldsForm { public List<CustomFieldEntry> Entries { get; set; } = []; }
    private sealed class CustomFieldEntry { public int DefinitionId { get; set; } public string? Value { get; set; } }

    private async Task ToggleMonitor()
    {
        await Data.SetIssueMonitorAsync(Id, !isMonitoring);
        await LoadIssue();
    }

    private sealed class MonitorModel { }

    private async Task AddTag()
    {
        tagMessage = null;
        if (string.IsNullOrWhiteSpace(addTag.Name)) return;
        try { tagMessage = await Data.AddIssueTagAsync(Id, addTag.Name); }
        catch (UnauthorizedAccessException ex) { tagMessage = ex.Message; }
        addTag = new();
        await LoadIssue();
    }

    private async Task RemoveTag()
    {
        tagMessage = null;
        if (removeTag.Id <= 0) return;
        try { await Data.RemoveIssueTagAsync(Id, removeTag.Id); }
        catch (UnauthorizedAccessException ex) { tagMessage = ex.Message; }
        removeTag = new();
        await LoadIssue();
    }

    private sealed class AddTagModel { public string Name { get; set; } = string.Empty; }
    private sealed class RemoveTagModel { public int Id { get; set; } }

    private async Task LoadIssue()
    {
        issue = await Data.GetIssueAsync(Id);
        history = issue is null ? [] : await Data.GetIssueHistoryAsync(Id);
        attachments = issue is null ? [] : await Data.GetIssueAttachmentsAsync(Id);
        relationships = issue is null ? [] : await Data.GetIssueRelationshipsAsync(Id);
        tags = issue is null ? [] : await Data.GetIssueTagsAsync(Id);
        allTags = issue is null ? [] : await Data.GetAllTagsAsync();
        customFields = issue is null ? [] : await Data.GetIssueCustomFieldsAsync(Id);
        similarIssues = issue is null ? [] : await Data.FindSimilarIssuesAsync(issue.ProjectId, issue.Title, excludeIssueId: issue.Id);
        isMonitoring = issue is not null && await Data.IsMonitoringIssueAsync(Id);
    }

    private async Task AddRelationship()
    {
        relMessage = null;
        if (relModel.TargetId <= 0) { relMessage = "Enter the issue number to link."; relIsError = true; return; }
        try
        {
            var error = await Data.AddIssueRelationshipAsync(Id, relModel.TargetId, relModel.Type);
            relIsError = error is not null;
            relMessage = error ?? "Linked.";
        }
        catch (UnauthorizedAccessException ex) { relIsError = true; relMessage = ex.Message; }
        relModel = new();
        await LoadIssue();
    }

    private async Task RemoveRelationship()
    {
        relMessage = null;
        if (removeRelModel.Id <= 0) { return; }
        try { await Data.RemoveIssueRelationshipAsync(removeRelModel.Id); relIsError = false; relMessage = "Removed."; }
        catch (UnauthorizedAccessException ex) { relIsError = true; relMessage = ex.Message; }
        removeRelModel = new();
        await LoadIssue();
    }

    private sealed class AddRelationshipModel
    {
        public IssueRelationshipType Type { get; set; } = IssueRelationshipType.RelatedTo;
        public int TargetId { get; set; }
    }

    private sealed class RemoveRelationshipModel
    {
        public int Id { get; set; }
    }

    // Desktop-host interactive handlers (the web host uses plain forms/links instead).
    private Task Download(AttachmentView a) => Transfer.DownloadAndOpenAsync(a.Id, a.FileName);

    private async Task DeleteAttachment(int attachmentId)
    {
        await Data.DeleteAttachmentAsync(attachmentId);
        await LoadIssue();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10L * 1024 * 1024);
            await Transfer.UploadAsync(Id, e.File.Name, e.File.ContentType, stream);
            await LoadIssue();
        }
        catch (Exception ex)
        {
            uploadError = ex.Message;
        }
    }

    private static string FormatSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024} KB"
        : $"{bytes / (1024 * 1024)} MB";

    private async Task AddNote()
    {
        if (string.IsNullOrWhiteSpace(noteModel.Text)) return;
        await Data.AddIssueNoteAsync(Id, noteModel.Text, noteModel.IsPrivate);
        noteModel = new();
        await LoadIssue();
    }

    private sealed class NoteFormModel
    {
        public string Text { get; set; } = string.Empty;
        public bool IsPrivate { get; set; }
    }
}
