@page "/issues/{Id:int}"
@attribute [Authorize]
@inject IOpenTrackDataService Data
@inject IAttachmentTransfer Transfer

<PageTitle>@(issue?.Title ?? "Issue")</PageTitle>

@if (issue is null)
{
    <p><em>Loading&hellip;</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <p class="text-muted mb-0">@issue.ProjectName / Issue #@issue.Id</p>
            <h1>@issue.Title</h1>
        </div>
        <AuthorizeView Policy="RequireUpdater">
            <Authorized>
                <a class="btn btn-outline-secondary" href="issues/@Id/edit">Edit</a>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="row mb-3">
        <div class="col-md-3"><strong>Status:</strong> @issue.Status</div>
        <div class="col-md-3"><strong>Severity:</strong> @issue.Severity</div>
        <div class="col-md-3"><strong>Priority:</strong> @issue.Priority</div>
        <div class="col-md-3"><strong>Reproducibility:</strong> @issue.Reproducibility</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3"><strong>Reporter:</strong> @issue.ReporterName</div>
        <div class="col-md-3"><strong>Assignee:</strong> @(issue.AssigneeName ?? "Unassigned")</div>
        <div class="col-md-3"><strong>Category:</strong> @(issue.CategoryName ?? "—")</div>
        <div class="col-md-3"><strong>Updated:</strong> @issue.UpdatedAt.ToString("g")</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3"><strong>Resolution:</strong> @issue.Resolution</div>
        <div class="col-md-3"><strong>Due:</strong> @(issue.DueDate is { } d ? d.ToString("d") : "—")</div>
        <div class="col-md-3"><strong>Affects:</strong> @(issue.AffectsVersionName ?? "—")</div>
        <div class="col-md-3"><strong>Fixed in:</strong> @(issue.FixVersionName ?? "—")</div>
    </div>
    @if (issue.IsPrivate)
    {
        <p><span class="badge text-bg-warning">Private issue</span></p>
    }

    <h2 class="h5">Description</h2>
    <p style="white-space: pre-wrap">@issue.Description</p>

    @if (!string.IsNullOrWhiteSpace(issue.StepsToReproduce))
    {
        <h2 class="h5">Steps to Reproduce</h2>
        <p style="white-space: pre-wrap">@issue.StepsToReproduce</p>
    }

    @if (!string.IsNullOrWhiteSpace(issue.ExpectedBehavior))
    {
        <h2 class="h5">Expected Behavior</h2>
        <p style="white-space: pre-wrap">@issue.ExpectedBehavior</p>
    }

    @if (!string.IsNullOrWhiteSpace(issue.ActualBehavior))
    {
        <h2 class="h5">Actual Behavior</h2>
        <p style="white-space: pre-wrap">@issue.ActualBehavior</p>
    }

    <h2 class="h5 mt-4">Attachments</h2>
    @if (attachments.Count == 0)
    {
        <p class="text-muted">No attachments.</p>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (var a in attachments)
            {
                <li class="mb-1 d-flex align-items-center gap-2">
                    @if (Transfer.Host == ClientHostKind.Web)
                    {
                        <a href="@Transfer.DownloadUrl(a.Id)">@a.FileName</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-link p-0" @onclick="() => Download(a)">@a.FileName</button>
                    }
                    <span class="text-muted small">@FormatSize(a.FileSize) &middot; @a.UploadedByName</span>
                    @if (Transfer.Host == ClientHostKind.Web)
                    {
                        <form method="post" action="/attachments/@a.Id/delete" class="d-inline">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm btn-outline-danger py-0">Delete</button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger py-0" @onclick="() => DeleteAttachment(a.Id)">Delete</button>
                    }
                </li>
            }
        </ul>
    }

    @if (Transfer.Host == ClientHostKind.Web)
    {
        <form method="post" action="/attachments/@issue.Id/upload" enctype="multipart/form-data" class="col-md-6 mb-2">
            <AntiforgeryToken />
            <div class="input-group">
                <input type="file" name="file" class="form-control" required />
                <button type="submit" class="btn btn-secondary">Upload</button>
            </div>
        </form>
    }
    else
    {
        <div class="col-md-6 mb-2">
            <InputFile OnChange="OnFileSelected" class="form-control" />
            @if (uploadError is not null)
            {
                <div class="text-danger small mt-1">@uploadError</div>
            }
        </div>
    }

    <h2 class="h5 mt-4">Notes</h2>
    @if (issue.Notes.Count == 0)
    {
        <p class="text-muted">No notes yet.</p>
    }
    else
    {
        @foreach (var note in issue.Notes)
        {
            <div class="border rounded p-2 mb-2 @(note.IsPrivate ? "border-warning" : "")">
                <div class="small text-muted">
                    @note.AuthorName &mdash; @note.CreatedAt.ToString("g")
                    @if (note.IsPrivate) { <span class="badge text-bg-warning ms-1">Private</span> }
                </div>
                <div style="white-space: pre-wrap">@note.Text</div>
            </div>
        }
    }

    <EditForm Model="noteModel" OnValidSubmit="AddNote" FormName="addNote" class="col-md-8 mt-3">
        <InputTextArea @bind-Value="noteModel.Text" class="form-control mb-2" rows="2" placeholder="Add a note&hellip;" />
        <div class="form-check mb-2">
            <InputCheckbox @bind-Value="noteModel.IsPrivate" class="form-check-input" id="notePrivate" />
            <label class="form-check-label" for="notePrivate">Private note (visible to developers and up)</label>
        </div>
        <button type="submit" class="btn btn-secondary btn-sm">Add Note</button>
    </EditForm>

    <h2 class="h5 mt-4">Relationships</h2>
    @if (relationships.Count == 0)
    {
        <p class="text-muted">No related issues.</p>
    }
    else
    {
        <ul>
            @foreach (var r in relationships)
            {
                <li>
                    @r.Label <a href="issues/@r.OtherIssueId">#@r.OtherIssueId</a> — @r.OtherIssueTitle
                    <span class="text-muted small">(@r.OtherProjectName)</span>
                </li>
            }
        </ul>
    }

    <AuthorizeView Policy="RequireUpdater" Context="auth">
        <Authorized>
            @if (relMessage is not null)
            {
                <div class="alert @(relIsError ? "alert-danger" : "alert-success") py-1">@relMessage</div>
            }
            <div class="row g-2">
                <div class="col-md-7">
                    <EditForm Model="relModel" OnValidSubmit="AddRelationship" FormName="addRelationship">
                        <div class="input-group">
                            <InputSelect @bind-Value="relModel.Type" class="form-select" style="max-width: 10rem">
                                <option value="@IssueRelationshipType.RelatedTo">related to</option>
                                <option value="@IssueRelationshipType.DuplicateOf">duplicate of</option>
                                <option value="@IssueRelationshipType.ParentOf">parent of</option>
                                <option value="@IssueRelationshipType.Blocks">blocks</option>
                            </InputSelect>
                            <span class="input-group-text">issue #</span>
                            <InputNumber @bind-Value="relModel.TargetId" class="form-control" />
                            <button type="submit" class="btn btn-secondary">Add</button>
                        </div>
                    </EditForm>
                </div>
                @if (relationships.Count > 0)
                {
                    <div class="col-md-5">
                        <EditForm Model="removeRelModel" OnValidSubmit="RemoveRelationship" FormName="removeRelationship">
                            <div class="input-group">
                                <InputSelect @bind-Value="removeRelModel.Id" class="form-select">
                                    <option value="0" disabled>Remove a link…</option>
                                    @foreach (var r in relationships)
                                    {
                                        <option value="@r.Id">@r.Label #@r.OtherIssueId</option>
                                    }
                                </InputSelect>
                                <button type="submit" class="btn btn-outline-danger">Remove</button>
                            </div>
                        </EditForm>
                    </div>
                }
            </div>
        </Authorized>
    </AuthorizeView>

    <h2 class="h5 mt-4">History</h2>
    @if (history.Count == 0)
    {
        <p class="text-muted">No changes recorded yet.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead><tr><th>When</th><th>Who</th><th>Field</th><th>From</th><th>To</th></tr></thead>
            <tbody>
                @foreach (var h in history)
                {
                    <tr>
                        <td>@h.ChangedAt.ToString("g")</td>
                        <td>@h.UserName</td>
                        <td>@h.FieldChanged</td>
                        <td>@(h.OldValue ?? "—")</td>
                        <td>@(h.NewValue ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private IssueDetail? issue;
    private IReadOnlyList<IssueHistoryEntry> history = [];
    private IReadOnlyList<IssueRelationshipView> relationships = [];
    private string? relMessage;
    private bool relIsError;
    private IReadOnlyList<AttachmentView> attachments = [];
    private string? uploadError;
    [SupplyParameterFromForm(FormName = "addNote")]
    private NoteFormModel noteModel { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "addRelationship")]
    private AddRelationshipModel relModel { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "removeRelationship")]
    private RemoveRelationshipModel removeRelModel { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        noteModel ??= new();
        relModel ??= new();
        removeRelModel ??= new();
        await LoadIssue();
    }

    private async Task LoadIssue()
    {
        issue = await Data.GetIssueAsync(Id);
        history = issue is null ? [] : await Data.GetIssueHistoryAsync(Id);
        attachments = issue is null ? [] : await Data.GetIssueAttachmentsAsync(Id);
        relationships = issue is null ? [] : await Data.GetIssueRelationshipsAsync(Id);
    }

    private async Task AddRelationship()
    {
        relMessage = null;
        if (relModel.TargetId <= 0) { relMessage = "Enter the issue number to link."; relIsError = true; return; }
        try
        {
            var error = await Data.AddIssueRelationshipAsync(Id, relModel.TargetId, relModel.Type);
            relIsError = error is not null;
            relMessage = error ?? "Linked.";
        }
        catch (UnauthorizedAccessException ex) { relIsError = true; relMessage = ex.Message; }
        relModel = new();
        await LoadIssue();
    }

    private async Task RemoveRelationship()
    {
        relMessage = null;
        if (removeRelModel.Id <= 0) { return; }
        try { await Data.RemoveIssueRelationshipAsync(removeRelModel.Id); relIsError = false; relMessage = "Removed."; }
        catch (UnauthorizedAccessException ex) { relIsError = true; relMessage = ex.Message; }
        removeRelModel = new();
        await LoadIssue();
    }

    private sealed class AddRelationshipModel
    {
        public IssueRelationshipType Type { get; set; } = IssueRelationshipType.RelatedTo;
        public int TargetId { get; set; }
    }

    private sealed class RemoveRelationshipModel
    {
        public int Id { get; set; }
    }

    // Desktop-host interactive handlers (the web host uses plain forms/links instead).
    private Task Download(AttachmentView a) => Transfer.DownloadAndOpenAsync(a.Id, a.FileName);

    private async Task DeleteAttachment(int attachmentId)
    {
        await Data.DeleteAttachmentAsync(attachmentId);
        await LoadIssue();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10L * 1024 * 1024);
            await Transfer.UploadAsync(Id, e.File.Name, e.File.ContentType, stream);
            await LoadIssue();
        }
        catch (Exception ex)
        {
            uploadError = ex.Message;
        }
    }

    private static string FormatSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024} KB"
        : $"{bytes / (1024 * 1024)} MB";

    private async Task AddNote()
    {
        if (string.IsNullOrWhiteSpace(noteModel.Text)) return;
        await Data.AddIssueNoteAsync(Id, noteModel.Text, noteModel.IsPrivate);
        noteModel = new();
        await LoadIssue();
    }

    private sealed class NoteFormModel
    {
        public string Text { get; set; } = string.Empty;
        public bool IsPrivate { get; set; }
    }
}
