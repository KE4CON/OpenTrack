@page "/issues/{Id:int}/edit"
@attribute [Authorize(Policy = "RequireUpdater")]
@inject IOpenTrackDataService Data
@inject NavigationManager Nav

<PageTitle>Edit Issue</PageTitle>

@if (!found)
{
    <p><em>Loading&hellip;</em></p>
}
else
{
    <p class="text-muted mb-0">@projectName / Issue #@Id</p>
    <h1>Edit Issue</h1>

    <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="editIssue" class="col-md-8">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />
        <input type="hidden" name="model.Loaded" value="true" />

        <div class="mb-3">
            <label class="form-label">Title</label>
            <InputText @bind-Value="model.Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea @bind-Value="model.Description" class="form-control" rows="4" />
        </div>

        <div class="mb-3">
            <label class="form-label">Steps to Reproduce</label>
            <InputTextArea @bind-Value="model.StepsToReproduce" class="form-control" rows="3" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Expected Behavior</label>
                <InputTextArea @bind-Value="model.ExpectedBehavior" class="form-control" rows="2" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Actual Behavior</label>
                <InputTextArea @bind-Value="model.ActualBehavior" class="form-control" rows="2" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Status</label>
                <InputSelect @bind-Value="model.Status" class="form-select">
                    @foreach (var s in Enum.GetValues<IssueStatus>())
                    {
                        <option value="@s">@s</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Severity</label>
                <InputSelect @bind-Value="model.Severity" class="form-select">
                    @foreach (var s in Enum.GetValues<IssueSeverity>())
                    {
                        <option value="@s">@s</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Priority</label>
                <InputSelect @bind-Value="model.Priority" class="form-select">
                    @foreach (var p in Enum.GetValues<IssuePriority>())
                    {
                        <option value="@p">@p</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Resolution</label>
                <InputSelect @bind-Value="model.Resolution" class="form-select">
                    @foreach (var r in Enum.GetValues<IssueResolution>())
                    {
                        <option value="@r">@r</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Assignee</label>
                <InputSelect @bind-Value="model.AssigneeId" class="form-select">
                    <option value="">Unassigned</option>
                    @foreach (var m in projectMembers)
                    {
                        <option value="@m.Id">@m.UserName</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Category</label>
                <InputSelect @bind-Value="model.CategoryId" class="form-select">
                    <option value="">(none)</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Reproducibility</label>
                <InputSelect @bind-Value="model.Reproducibility" class="form-select">
                    @foreach (var r in Enum.GetValues<IssueReproducibility>())
                    {
                        <option value="@r">@r</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Due Date <span class="text-muted">(optional)</span></label>
                <InputDate @bind-Value="model.DueDate" class="form-control" />
            </div>
        </div>

        <div class="form-check mb-3">
            <InputCheckbox @bind-Value="model.IsSticky" class="form-check-input" id="sticky" />
            <label class="form-check-label" for="sticky">Sticky (pinned to top of project issue list)</label>
        </div>

        <div class="form-check mb-3">
            <InputCheckbox @bind-Value="model.IsPrivate" class="form-check-input" id="private" />
            <label class="form-check-label" for="private">Private</label>
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="issues/@Id" class="btn btn-link">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromForm]
    private IssueEditModel model { get; set; } = new();

    private bool found;
    private string projectName = string.Empty;
    private IReadOnlyList<CategoryView> categories = [];
    private IReadOnlyList<ProjectMemberView> projectMembers = [];

    protected override async Task OnParametersSetAsync()
    {
        var issue = await Data.GetIssueAsync(Id);
        if (issue is null) return;
        found = true;
        projectName = issue.ProjectName;

        categories = await Data.GetProjectCategoriesAsync(issue.ProjectId);
        projectMembers = await Data.GetProjectMembersAsync(issue.ProjectId);

        if (!model.Loaded)
        {
            model.Title = issue.Title;
            model.Description = issue.Description;
            model.StepsToReproduce = issue.StepsToReproduce;
            model.ExpectedBehavior = issue.ExpectedBehavior;
            model.ActualBehavior = issue.ActualBehavior;
            model.Status = issue.Status;
            model.Severity = issue.Severity;
            model.Priority = issue.Priority;
            model.Reproducibility = issue.Reproducibility;
            model.Resolution = issue.Resolution;
            model.AssigneeId = issue.AssigneeId;
            model.CategoryId = issue.CategoryId;
            model.IsSticky = issue.IsSticky;
            model.IsPrivate = issue.IsPrivate;
            model.DueDate = issue.DueDate;
            model.Loaded = true;
        }
    }

    private async Task HandleSubmit()
    {
        // Change-tracking for IssueHistory (status/assignee) is handled inside the
        // data service, so the page just submits the new values.
        await Data.UpdateIssueAsync(Id, new UpdateIssueInput(
            model.Title, model.Description, model.StepsToReproduce,
            model.ExpectedBehavior, model.ActualBehavior,
            model.Status, model.Severity, model.Priority, model.Reproducibility,
            model.Resolution, model.AssigneeId, model.CategoryId, model.IsSticky, model.IsPrivate, model.DueDate));
        Nav.NavigateTo($"issues/{Id}");
    }

    private sealed class IssueEditModel
    {
        public bool Loaded { get; set; }

        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(OpenTrack.Core.Validation.FieldLimits.IssueTitle)]
        public string Title { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Description { get; set; } = string.Empty;

        public string? StepsToReproduce { get; set; }
        public string? ExpectedBehavior { get; set; }
        public string? ActualBehavior { get; set; }
        public IssueStatus Status { get; set; }
        public IssueSeverity Severity { get; set; }
        public IssuePriority Priority { get; set; }
        public IssueReproducibility Reproducibility { get; set; }
        public IssueResolution Resolution { get; set; }
        public int? AssigneeId { get; set; }
        public int? CategoryId { get; set; }
        public bool IsSticky { get; set; }
        public bool IsPrivate { get; set; }
        public DateTime? DueDate { get; set; }
    }
}
