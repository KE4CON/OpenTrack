@page "/issues"
@attribute [Authorize]
@inject IOpenTrackDataService Data

<PageTitle>Issues</PageTitle>

<h1>All Issues</h1>

@* Form GET (not an interactive @bind) so the filter works in the static-SSR web host as well
   as the interactive desktop host — a shared page can't declare an interactive @rendermode. *@
<form method="get" class="mb-3 col-md-6">
    <label class="form-label">Filter by project</label>
    <div class="input-group">
        <select class="form-select" name="projectId">
            <option value="">All Projects</option>
            @foreach (var p in projectOptions)
            {
                if (p.Id == (ProjectId ?? 0))
                {
                    <option value="@p.Id" selected>@p.Name</option>
                }
                else
                {
                    <option value="@p.Id">@p.Name</option>
                }
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary">Apply</button>
    </div>
</form>

@if (issues.Count == 0)
{
    <p class="text-muted">No issues match this filter.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Project</th>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Reporter</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in issues)
            {
                <tr>
                    <td>@i.Id</td>
                    <td>@i.ProjectName</td>
                    <td><a href="issues/@i.Id">@i.Title</a></td>
                    <td>@i.Status</td>
                    <td>@i.Priority</td>
                    <td>@i.ReporterName</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromQuery] public int? ProjectId { get; set; }

    private IReadOnlyList<IssueRow> issues = [];
    private List<(int Id, string Name)> projectOptions = [];

    protected override async Task OnParametersSetAsync()
    {
        projectOptions = (await Data.GetProjectsAsync())
            .Select(p => (p.Id, p.Name))
            .ToList();

        var filter = ProjectId is > 0 ? ProjectId : null;
        issues = await Data.GetIssuesAsync(filter);
    }
}
