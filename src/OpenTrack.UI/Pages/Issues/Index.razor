@page "/issues"
@attribute [Authorize]
@inject IOpenTrackDataService Data

<PageTitle>Issues</PageTitle>

<h1>Issues</h1>

@* Form GET (not interactive @bind) so the filter works in the static-SSR web host as well as the
   interactive desktop host — a shared page can't declare an interactive @rendermode. Every field is
   a query parameter bound below via [SupplyParameterFromQuery]. *@
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label">Project</label>
        <select class="form-select" name="ProjectId">
            <option value="">All projects</option>
            @foreach (var p in projectOptions)
            {
                <option value="@p.Id" selected="@(p.Id == ProjectId)">@p.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Status</label>
        <select class="form-select" name="Status">
            <option value="">Any</option>
            @foreach (var s in Enum.GetValues<IssueStatus>())
            {
                <option value="@s" selected="@(Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Severity</label>
        <select class="form-select" name="Severity">
            <option value="">Any</option>
            @foreach (var s in Enum.GetValues<IssueSeverity>())
            {
                <option value="@s" selected="@(Severity == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Priority</label>
        <select class="form-select" name="Priority">
            <option value="">Any</option>
            @foreach (var p in Enum.GetValues<IssuePriority>())
            {
                <option value="@p" selected="@(Priority == p)">@p</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Text</label>
        <input class="form-control" name="Text" value="@Text" placeholder="title or description" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Sort by</label>
        <select class="form-select" name="Sort">
            @foreach (var s in Enum.GetValues<IssueSort>())
            {
                <option value="@s" selected="@(EffectiveSort == s)">@SortLabel(s)</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Search</button>
        <a href="issues" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<p class="text-muted small">@issues.Count issue(s) match.</p>

@if (issues.Count == 0)
{
    <p class="text-muted">No issues match this filter.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Project</th>
                <th>Title</th>
                <th>Status</th>
                <th>Severity</th>
                <th>Priority</th>
                <th>Assignee</th>
                <th>Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in issues)
            {
                <tr>
                    <td>@i.Id</td>
                    <td>@i.ProjectName</td>
                    <td><a href="issues/@i.Id">@i.Title</a></td>
                    <td>@i.Status</td>
                    <td>@i.Severity</td>
                    <td>@i.Priority</td>
                    <td>@(i.AssigneeName ?? "Unassigned")</td>
                    <td>@i.UpdatedAt.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromQuery] public int? ProjectId { get; set; }
    [SupplyParameterFromQuery] public IssueStatus? Status { get; set; }
    [SupplyParameterFromQuery] public IssueSeverity? Severity { get; set; }
    [SupplyParameterFromQuery] public IssuePriority? Priority { get; set; }
    [SupplyParameterFromQuery] public string? Text { get; set; }
    [SupplyParameterFromQuery] public IssueSort? Sort { get; set; }

    private IssueSort EffectiveSort => Sort ?? IssueSort.UpdatedDesc;

    private IReadOnlyList<IssueRow> issues = [];
    private List<(int Id, string Name)> projectOptions = [];

    protected override async Task OnParametersSetAsync()
    {
        projectOptions = (await Data.GetProjectsAsync())
            .Select(p => (p.Id, p.Name))
            .ToList();

        var filter = new IssueFilter(
            ProjectId: ProjectId is > 0 ? ProjectId : null,
            Status: Status,
            Severity: Severity,
            Priority: Priority,
            Text: string.IsNullOrWhiteSpace(Text) ? null : Text,
            Sort: EffectiveSort);

        issues = await Data.GetIssuesAsync(filter);
    }

    private static string SortLabel(IssueSort s) => s switch
    {
        IssueSort.UpdatedDesc => "Updated (newest)",
        IssueSort.UpdatedAsc => "Updated (oldest)",
        IssueSort.CreatedDesc => "Created (newest)",
        IssueSort.CreatedAsc => "Created (oldest)",
        IssueSort.PriorityDesc => "Priority (high→low)",
        IssueSort.SeverityDesc => "Severity (high→low)",
        IssueSort.StatusAsc => "Status",
        IssueSort.IdDesc => "ID (newest)",
        IssueSort.IdAsc => "ID (oldest)",
        _ => s.ToString()
    };
}
