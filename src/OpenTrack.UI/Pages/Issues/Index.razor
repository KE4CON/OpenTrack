@page "/issues"
@attribute [Authorize]
@inject IOpenTrackDataService Data
@inject NavigationManager Nav

<PageTitle>Issues</PageTitle>

<h1>Issues</h1>

@if (aiEnabled)
{
    <EditForm Model="aiSearch" OnValidSubmit="HandleAiSearch" FormName="aiSearch" class="mb-3">
        <label class="form-label">✨ Ask in plain English</label>
        <div class="input-group">
            <InputText @bind-Value="aiSearch.Query" class="form-control"
                       placeholder="e.g. high-priority crashes nobody has touched in a month" />
            <button type="submit" class="btn btn-outline-primary">Search with AI</button>
        </div>
        <div class="form-text">Turns your request into the filters below (status, severity, priority,
            keywords, stale, project). You can then tweak them by hand and search again. Uses your
            configured AI provider.</div>
    </EditForm>
    @if (aiSearchMessage is not null)
    {
        <div class="alert alert-warning py-1">@aiSearchMessage</div>
    }
}

@* Form GET (not interactive @bind) so the filter works in the static-SSR web host as well as the
   interactive desktop host — a shared page can't declare an interactive @rendermode. Every field is
   a query parameter bound below via [SupplyParameterFromQuery]. *@
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label">Project</label>
        <select class="form-select" name="ProjectId">
            <option value="">All projects</option>
            @foreach (var p in projectOptions)
            {
                <option value="@p.Id" selected="@(p.Id == ProjectId)">@p.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Status</label>
        <select class="form-select" name="Status">
            <option value="">Any</option>
            @foreach (var s in Enum.GetValues<IssueStatus>())
            {
                <option value="@s" selected="@(Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Severity</label>
        <select class="form-select" name="Severity">
            <option value="">Any</option>
            @foreach (var s in Enum.GetValues<IssueSeverity>())
            {
                <option value="@s" selected="@(Severity == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Priority</label>
        <select class="form-select" name="Priority">
            <option value="">Any</option>
            @foreach (var p in Enum.GetValues<IssuePriority>())
            {
                <option value="@p" selected="@(Priority == p)">@p</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Tag</label>
        <select class="form-select" name="TagId">
            <option value="">Any</option>
            @foreach (var t in tagOptions)
            {
                <option value="@t.Id" selected="@(t.Id == TagId)">@t.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Text</label>
        <input class="form-control" name="Text" value="@Text" placeholder="title, description, or notes" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Sort by</label>
        <select class="form-select" name="Sort">
            @foreach (var s in Enum.GetValues<IssueSort>())
            {
                <option value="@s" selected="@(EffectiveSort == s)">@SortLabel(s)</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-center">
        <div class="form-check mt-4">
            <input class="form-check-input" type="checkbox" name="Stale" value="true" id="staleChk" checked="@(Stale == true)" />
            <label class="form-check-label" for="staleChk">Stale only (open, 30+ days idle)</label>
        </div>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Search</button>
        <a href="issues" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <span class="text-muted small">Saved filters:</span>
    @if (savedFilters.Count == 0)
    {
        <span class="text-muted small fst-italic">none yet</span>
    }
    else
    {
        @foreach (var f in savedFilters)
        {
            <a class="badge rounded-pill text-bg-light border text-decoration-none" href="issues?@f.Query">@f.Name</a>
        }
    }

    <EditForm Model="saveFilter" OnValidSubmit="SaveCurrentFilter" FormName="saveFilter" class="d-inline-flex">
        <div class="input-group input-group-sm" style="width: 20rem;">
            <InputText @bind-Value="saveFilter.Name" class="form-control" placeholder="Save current filter as…" />
            <button type="submit" class="btn btn-outline-primary">Save</button>
        </div>
    </EditForm>

    @if (savedFilters.Count > 0)
    {
        <EditForm Model="deleteFilter" OnValidSubmit="DeleteSavedFilter" FormName="deleteFilter" class="d-inline-flex">
            <div class="input-group input-group-sm" style="width: 16rem;">
                <InputSelect @bind-Value="deleteFilter.Id" class="form-select">
                    <option value="0" disabled>Delete a saved filter…</option>
                    @foreach (var f in savedFilters) { <option value="@f.Id">@f.Name</option> }
                </InputSelect>
                <button type="submit" class="btn btn-outline-danger">Delete</button>
            </div>
        </EditForm>
    }
</div>
@if (savedFilterMessage is not null)
{
    <div class="alert alert-danger py-1">@savedFilterMessage</div>
}

<p class="text-muted small">@issues.Count issue(s) match.</p>

@if (issues.Count == 0)
{
    <p class="text-muted">No issues match this filter.</p>
}
else
{
    <AuthorizeView Policy="RequireUpdater" Context="auth">
        <Authorized>
            @if (bulkMessage is not null)
            {
                <div class="alert alert-info py-1">@bulkMessage</div>
            }
            <EditForm Model="bulk" OnValidSubmit="ApplyBulk" FormName="bulk">
                <div class="row g-2 align-items-end mb-2">
                    <div class="col-auto">
                        <label class="form-label small mb-0">Bulk action on selected</label>
                        <InputSelect @bind-Value="bulk.Action" class="form-select form-select-sm">
                            <option value="@BulkActionType.SetStatus">Set status…</option>
                            <option value="@BulkActionType.Close">Close</option>
                            <option value="@BulkActionType.Unassign">Unassign</option>
                            <option value="@BulkActionType.AddTag">Add tag…</option>
                        </InputSelect>
                    </div>
                    <div class="col-auto">
                        <InputSelect @bind-Value="bulk.Status" class="form-select form-select-sm">
                            @foreach (var s in Enum.GetValues<IssueStatus>()) { <option value="@s">@s</option> }
                        </InputSelect>
                    </div>
                    <div class="col-auto">
                        <InputText @bind-Value="bulk.Tag" class="form-control form-control-sm" placeholder="tag" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-secondary">Apply</button>
                    </div>
                </div>
                @IssueTable(true)
            </EditForm>
        </Authorized>
        <NotAuthorized>
            @IssueTable(false)
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [SupplyParameterFromQuery] public int? ProjectId { get; set; }
    [SupplyParameterFromQuery] public IssueStatus? Status { get; set; }
    [SupplyParameterFromQuery] public IssueSeverity? Severity { get; set; }
    [SupplyParameterFromQuery] public IssuePriority? Priority { get; set; }
    [SupplyParameterFromQuery] public string? Text { get; set; }
    [SupplyParameterFromQuery] public int? TagId { get; set; }
    [SupplyParameterFromQuery] public IssueSort? Sort { get; set; }
    [SupplyParameterFromQuery] public bool? Stale { get; set; }

    private IssueSort? prefDefaultSort;
    private IssueSort EffectiveSort => Sort ?? prefDefaultSort ?? IssueSort.UpdatedDesc;

    private IReadOnlyList<IssueRow> issues = [];
    private List<(int Id, string Name)> projectOptions = [];
    private IReadOnlyList<TagView> tagOptions = [];

    [SupplyParameterFromForm(FormName = "bulk")] private BulkModel bulk { get; set; } = default!;
    private string? bulkMessage;

    private IReadOnlyList<SavedFilterView> savedFilters = [];
    [SupplyParameterFromForm(FormName = "saveFilter")] private NameOnly saveFilter { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "deleteFilter")] private IdOnly deleteFilter { get; set; } = default!;
    private string? savedFilterMessage;

    private bool aiEnabled;
    [SupplyParameterFromForm(FormName = "aiSearch")] private AiQuery aiSearch { get; set; } = default!;
    private string? aiSearchMessage;

    protected override async Task OnParametersSetAsync()
    {
        bulk ??= new();
        saveFilter ??= new();
        deleteFilter ??= new();
        aiSearch ??= new();
        projectOptions = (await Data.GetProjectsAsync())
            .Select(p => (p.Id, p.Name))
            .ToList();
        tagOptions = await Data.GetAllTagsAsync();
        savedFilters = await Data.GetSavedFiltersAsync();
        prefDefaultSort = (await Data.GetPreferencesAsync()).DefaultSort;
        aiEnabled = await Data.IsAiEnabledAsync();
        await LoadIssues();
    }

    // Ask the AI to turn plain English into filter fields, then navigate to the same GET-filtered issue
    // list. It can only ever produce a filter the user could have built by hand (project match is limited
    // server-side to visible projects), so this adds no query power and can't bypass the ACL.
    private async Task HandleAiSearch()
    {
        aiSearchMessage = null;
        if (string.IsNullOrWhiteSpace(aiSearch.Query)) return;

        var v = await Data.InterpretIssueSearchAsync(aiSearch.Query);
        if (v is null) { aiSearchMessage = "AI couldn't interpret that search right now."; return; }

        var parts = new List<string>();
        if (v.ProjectName is { } pn)
        {
            var match = projectOptions.FirstOrDefault(p => string.Equals(p.Name, pn, StringComparison.OrdinalIgnoreCase));
            if (match.Id > 0) parts.Add($"ProjectId={match.Id}");
        }
        if (v.Status is { } s) parts.Add($"Status={s}");
        if (v.Severity is { } sv) parts.Add($"Severity={sv}");
        if (v.Priority is { } p) parts.Add($"Priority={p}");
        if (!string.IsNullOrWhiteSpace(v.Text)) parts.Add($"Text={Uri.EscapeDataString(v.Text)}");
        if (v.Sort is { } so) parts.Add($"Sort={so}");
        if (v.Stale) parts.Add("Stale=true");

        if (parts.Count == 0)
        {
            aiSearchMessage = "AI didn't find any filters in that request — try naming a status, severity, priority, keywords, or \"stale\".";
            return;
        }
        Nav.NavigateTo($"issues?{string.Join("&", parts)}");
    }

    private sealed class AiQuery { public string? Query { get; set; } }

    // Rebuild the current filter as a query string, so it can be saved and re-applied (or shared).
    private string CurrentQuery()
    {
        var parts = new List<string>();
        if (ProjectId is > 0) parts.Add($"ProjectId={ProjectId}");
        if (Status is { } s) parts.Add($"Status={s}");
        if (Severity is { } sv) parts.Add($"Severity={sv}");
        if (Priority is { } p) parts.Add($"Priority={p}");
        if (TagId is > 0) parts.Add($"TagId={TagId}");
        if (!string.IsNullOrWhiteSpace(Text)) parts.Add($"Text={Uri.EscapeDataString(Text)}");
        if (Sort is { } so) parts.Add($"Sort={so}");
        if (Stale == true) parts.Add("Stale=true");
        return string.Join("&", parts);
    }

    private async Task SaveCurrentFilter()
    {
        savedFilterMessage = null;
        if (!string.IsNullOrWhiteSpace(saveFilter.Name))
            savedFilterMessage = await Data.SaveFilterAsync(saveFilter.Name!, CurrentQuery());
        saveFilter = new();
        savedFilters = await Data.GetSavedFiltersAsync();
    }

    private async Task DeleteSavedFilter()
    {
        if (deleteFilter.Id > 0) await Data.DeleteSavedFilterAsync(deleteFilter.Id);
        deleteFilter = new();
        savedFilters = await Data.GetSavedFiltersAsync();
    }

    private sealed class NameOnly { public string? Name { get; set; } }
    private sealed class IdOnly { public int Id { get; set; } }

    private async Task LoadIssues()
    {
        var filter = new IssueFilter(
            ProjectId: ProjectId is > 0 ? ProjectId : null,
            Status: Status,
            Severity: Severity,
            Priority: Priority,
            Text: string.IsNullOrWhiteSpace(Text) ? null : Text,
            TagId: TagId is > 0 ? TagId : null,
            Sort: EffectiveSort,
            StaleBeforeUtc: Stale == true ? DateTime.UtcNow.AddDays(-IssueDefaults.StaleDays) : null);
        issues = await Data.GetIssuesAsync(filter);
    }

    private async Task ApplyBulk()
    {
        bulkMessage = null;
        var ids = bulk.SelectedIds;
        if (ids is null || ids.Count == 0) { bulkMessage = "No issues selected."; bulk = new(); return; }

        var action = bulk.Action switch
        {
            BulkActionType.SetStatus => new BulkAction(BulkActionType.SetStatus, Status: bulk.Status),
            BulkActionType.Close => new BulkAction(BulkActionType.Close),
            BulkActionType.Unassign => new BulkAction(BulkActionType.Unassign),
            BulkActionType.AddTag => new BulkAction(BulkActionType.AddTag, Tag: bulk.Tag),
            _ => new BulkAction(BulkActionType.SetStatus, Status: bulk.Status),
        };
        var result = await Data.BulkUpdateIssuesAsync(ids, action);
        bulkMessage = $"Updated {result.Updated}, skipped {result.Skipped}.";
        bulk = new();
        await LoadIssues();
    }

    private RenderFragment IssueTable(bool withCheckboxes) => @<table class="table table-hover align-middle">
        <thead>
            <tr>
                @if (withCheckboxes) { <th></th> }
                <th>#</th>
                <th>Project</th>
                <th>Title</th>
                <th>Status</th>
                <th>Severity</th>
                <th>Priority</th>
                <th>Assignee</th>
                <th>Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in issues)
            {
                <tr>
                    @if (withCheckboxes)
                    {
                        <td><input type="checkbox" name="SelectedIds" value="@i.Id" /></td>
                    }
                    <td>@i.Id</td>
                    <td>@i.ProjectName</td>
                    <td><a href="issues/@i.Id">@i.Title</a></td>
                    <td>@i.Status</td>
                    <td>@i.Severity</td>
                    <td>@i.Priority</td>
                    <td>@(i.AssigneeName ?? "Unassigned")</td>
                    <td>@i.UpdatedAt.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>;

    private sealed class BulkModel
    {
        public List<int> SelectedIds { get; set; } = [];
        public BulkActionType Action { get; set; } = BulkActionType.SetStatus;
        public IssueStatus Status { get; set; } = IssueStatus.Acknowledged;
        public string? Tag { get; set; }
    }

    private static string SortLabel(IssueSort s) => s switch
    {
        IssueSort.UpdatedDesc => "Updated (newest)",
        IssueSort.UpdatedAsc => "Updated (oldest)",
        IssueSort.CreatedDesc => "Created (newest)",
        IssueSort.CreatedAsc => "Created (oldest)",
        IssueSort.PriorityDesc => "Priority (high→low)",
        IssueSort.SeverityDesc => "Severity (high→low)",
        IssueSort.StatusAsc => "Status",
        IssueSort.IdDesc => "ID (newest)",
        IssueSort.IdAsc => "ID (oldest)",
        _ => s.ToString()
    };
}
