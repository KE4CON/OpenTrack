@page "/projects/{ProjectId:int}/issues/create"
@attribute [Authorize]
@inject IOpenTrackDataService Data
@inject NavigationManager Nav

<PageTitle>New Issue</PageTitle>

@if (project is null)
{
    <p><em>Loading&hellip;</em></p>
}
else
{
    <h1>New Issue &mdash; @project.Name</h1>

    <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="createIssue" class="col-md-8">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-3">
            <label class="form-label">Title</label>
            <InputText @bind-Value="model.Title" class="form-control" />
            <ValidationMessage For="() => model.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea @bind-Value="model.Description" class="form-control" rows="4" />
            <div class="form-text">Markdown supported — **bold**, `code`, and ```fenced``` code blocks for stack traces.</div>
            <ValidationMessage For="() => model.Description" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Steps to Reproduce</label>
                <InputTextArea @bind-Value="model.StepsToReproduce" class="form-control" rows="3" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Category</label>
                <InputSelect @bind-Value="model.CategoryId" class="form-select">
                    <option value="">(none)</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Expected Behavior</label>
                <InputTextArea @bind-Value="model.ExpectedBehavior" class="form-control" rows="2" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Actual Behavior</label>
                <InputTextArea @bind-Value="model.ActualBehavior" class="form-control" rows="2" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Severity</label>
                <InputSelect @bind-Value="model.Severity" class="form-select">
                    @foreach (var s in Enum.GetValues<IssueSeverity>())
                    {
                        <option value="@s">@s</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Priority</label>
                <InputSelect @bind-Value="model.Priority" class="form-select">
                    @foreach (var p in Enum.GetValues<IssuePriority>())
                    {
                        <option value="@p">@p</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Reproducibility</label>
                <InputSelect @bind-Value="model.Reproducibility" class="form-select">
                    @foreach (var r in Enum.GetValues<IssueReproducibility>())
                    {
                        <option value="@r">@r</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Due Date <span class="text-muted">(optional)</span></label>
                <InputDate @bind-Value="model.DueDate" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Affects Version</label>
                <InputSelect @bind-Value="model.AffectsVersionId" class="form-select">
                    <option value="">(none)</option>
                    @foreach (var v in versions) { <option value="@v.Id">@v.Name</option> }
                </InputSelect>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Fix Version</label>
                <InputSelect @bind-Value="model.FixVersionId" class="form-select">
                    <option value="">(none)</option>
                    @foreach (var v in versions) { <option value="@v.Id">@v.Name</option> }
                </InputSelect>
            </div>
        </div>

        @if (error is not null)
        {
            <p class="text-danger">@error</p>
        }

        @if (aiSuggestedTags is { Count: > 0 })
        {
            <div class="alert alert-info py-1">✨ Suggested tags: @string.Join(", ", aiSuggestedTags) — add them on the issue after you create it.</div>
        }

        <button type="submit" name="Action" value="save" class="btn btn-primary">Submit Issue</button>
        @if (aiEnabled)
        {
            <button type="submit" name="Action" value="ai" class="btn btn-outline-secondary" title="Uses your configured AI provider">✨ Suggest with AI</button>
        }
        <a href="projects/@ProjectId" class="btn btn-link">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public int ProjectId { get; set; }

    private ProjectDetail? project;
    private IReadOnlyList<CategoryView> categories = [];
    private IReadOnlyList<ProjectVersionView> versions = [];
    [SupplyParameterFromForm]
    private IssueFormModel model { get; set; } = default!;
    private string? error;
    private bool aiEnabled;
    private IReadOnlyList<string> aiSuggestedTags = [];

    protected override async Task OnParametersSetAsync()
    {
        model ??= new();
        project = await Data.GetProjectAsync(ProjectId);
        categories = await Data.GetProjectCategoriesAsync(ProjectId);
        versions = await Data.GetProjectVersionsAsync(ProjectId);
        aiEnabled = await Data.IsAiEnabledAsync();
    }

    private async Task HandleSubmit()
    {
        // The "Suggest with AI" button pre-fills the form instead of creating the issue.
        if (model.Action == "ai")
        {
            error = null;
            if (!string.IsNullOrWhiteSpace(model.Title))
            {
                var s = await Data.SuggestTriageAsync(ProjectId, model.Title, model.Description);
                if (s is null) { error = "AI couldn't suggest a triage right now."; }
                else
                {
                    if (s.Severity is { } sv) model.Severity = sv;
                    if (s.Priority is { } pr) model.Priority = pr;
                    if (s.Category is { } cat)
                        model.CategoryId = categories.FirstOrDefault(c => string.Equals(c.Name, cat, StringComparison.OrdinalIgnoreCase))?.Id;
                    aiSuggestedTags = s.Tags;
                }
            }
            return;
        }

        try
        {
            var id = await Data.CreateIssueAsync(ProjectId, new CreateIssueInput(
                model.Title, model.Description, model.StepsToReproduce,
                model.ExpectedBehavior, model.ActualBehavior, model.CategoryId,
                model.Severity, model.Priority, model.Reproducibility, model.DueDate,
                model.AffectsVersionId, model.FixVersionId));
            Nav.NavigateTo($"issues/{id}");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            error = ex.Message;
        }
    }

    private sealed class IssueFormModel
    {
        public string? Action { get; set; }

        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(OpenTrack.Core.Validation.FieldLimits.IssueTitle)]
        public string Title { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Description { get; set; } = string.Empty;

        public string? StepsToReproduce { get; set; }
        public string? ExpectedBehavior { get; set; }
        public string? ActualBehavior { get; set; }
        public int? CategoryId { get; set; }
        public IssueSeverity Severity { get; set; } = IssueSeverity.Minor;
        public IssuePriority Priority { get; set; } = IssuePriority.Normal;
        public IssueReproducibility Reproducibility { get; set; } = IssueReproducibility.HaveNotTried;
        public DateTime? DueDate { get; set; }
        public int? AffectsVersionId { get; set; }
        public int? FixVersionId { get; set; }
    }
}
