@inject DesktopAuthState Auth
@inject NavigationManager Nav
@inject OpenTrack.UI.Services.IOpenTrackDataService Data

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">OpenTrack</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="projects">
                        <span class="bi bi-folder-fill-nav-menu" aria-hidden="true"></span> Projects
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="issues">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Issues
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="notifications">
                        <span class="bi bi-bell-fill-nav-menu" aria-hidden="true"></span> Notifications
                        @if (unread > 0)
                        {
                            <span class="badge text-bg-danger rounded-pill ms-1">@unread</span>
                        }
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link text-start" @onclick="SignOut">
                        <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Sign out
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Always available (even before sign-in) so the server address can be configured first. *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Settings
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private int unread;

    protected override async Task OnParametersSetAsync()
    {
        try { unread = Auth.IsSignedIn ? await Data.GetUnreadNotificationCountAsync() : 0; }
        catch { unread = 0; }
    }

    private void SignOut()
    {
        Auth.SignOut();
        Nav.NavigateTo("/login", replace: true);
    }
}