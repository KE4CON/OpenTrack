@inject DesktopAuthState Auth
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">OpenTrack</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="projects">
                        <span class="bi bi-folder-fill-nav-menu" aria-hidden="true"></span> Projects
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="issues">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Issues
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link text-start" @onclick="SignOut">
                        <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Sign out
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private void SignOut()
    {
        Auth.SignOut();
        Nav.NavigateTo("/login", replace: true);
    }
}