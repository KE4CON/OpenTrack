@page "/settings"
@using Microsoft.Maui.Storage
@using OpenTrack.Desktop.Services
@inject ApiEndpoint Endpoint

<PageTitle>Settings</PageTitle>

<h1 class="h3 mb-3">Settings</h1>

<div style="max-width: 560px">
    <label class="form-label">Server address (OpenTrack server)</label>
    <input class="form-control" @bind="url" placeholder="http://192.168.1.50:5003" />
    <div class="form-text">
        The address of your OpenTrack server. Use <code>http://</code> on a trusted local network,
        or <code>https://</code> if the server requires HTTPS. Example:
        <code>http://192.168.1.50:5003</code>. Leaving this blank is not allowed.
    </div>

    @if (message is not null)
    {
        <div class="mt-2 @(isError ? "text-danger" : "text-success")">@message</div>
    }

    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary" @onclick="Save">Save</button>
        <a class="btn btn-outline-secondary" href="/">Back</a>
    </div>
</div>

@code {
    private string url = "";
    private string? message;
    private bool isError;

    protected override void OnInitialized() => url = Endpoint.BaseUrl;

    private void Save()
    {
        var trimmed = (url ?? string.Empty).Trim();
        if (!Uri.TryCreate(trimmed, UriKind.Absolute, out var uri) || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            isError = true;
            message = "Enter a valid address that starts with http:// or https://";
            return;
        }

        Endpoint.BaseUrl = trimmed;
        Preferences.Default.Set(ApiEndpoint.PreferenceKey, trimmed);
        isError = false;
        message = "Saved. New requests (including sign-in) will use this server.";
    }
}
